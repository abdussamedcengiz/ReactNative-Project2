# Bu dosyayi ".env" olarak kopyalayip kendi anahtarinizi yazin.
# .env .gitignore'da; depoya gonderilmez.
#
# Anahtar https://docs.developer.yelp.com adresinden alinir.
#
# Expo yalnizca "EXPO_PUBLIC_" onekli degiskenleri istemci koduna
# gomer. Deger derleme sirasinda gomuldugu icin degistirdiginizde
# gelistirme sunucusunu yeniden baslatmaniz gerekir.
EXPO_PUBLIC_YELP_API_KEY=
